# ===================================================
# RITKARA VEYRA — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development.
# Do NOT commit actual secrets or production keys to version control.
# ===================================================

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="RITKARA VEYRA"
NEXT_PUBLIC_SITE_TAGLINE="MAKE COMPLEXITY WORK."

# Analytics (Optional — activated only after user supplies ID and visitor consents)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Admin Authentication Secret (Required for secure admin session signing)
# Generate a random 32-character string: openssl rand -base64 32
ADMIN_JWT_SECRET=temporary_development_secret_change_in_production_32chars!

# Supabase Integration (Optional: Local persistent CMS store is active by default)
# When ready to connect cloud PostgreSQL/Auth/Storage:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Project Enquiry Notifications (Optional webhook or SMTP)
ENQUIRY_NOTIFICATION_EMAIL=
DISCORD_LEAD_WEBHOOK_URL=
SLACK_LEAD_WEBHOOK_URL=

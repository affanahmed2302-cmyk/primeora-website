# ===================================================
# RITKARA VEYRA — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development.
# Do NOT commit actual secrets or production keys to version control.
# ===================================================

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="RITKARA VEYRA"
NEXT_PUBLIC_SITE_TAGLINE="MAKE COMPLEXITY WORK."

# Analytics (Optional — activated only after user supplies ID and visitor consents)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Admin Authentication Secret (MANDATORY for secure HMAC admin session signing)
# Generate a secure 32+ character key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=

# Administrative Credential Provisioning (Zero default passwords)
# Option A: Supabase Auth (invitation only via Supabase Dashboard)
# Option B: Environment-provisioned admin credentials:
# Generate with: node -e "const c=require('crypto'); const s=c.randomBytes(16).toString('hex'); const h=c.pbkdf2Sync('YOUR_PASSWORD', s, 100000, 64, 'sha512').toString('hex'); console.log('ADMIN_PASSWORD_SALT=' + s); console.log('ADMIN_PASSWORD_HASH=' + h);"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_SALT=
ADMIN_ROLE=super_admin
ADMIN_FULL_NAME="System Administrator"

# Supabase PostgreSQL, Auth & Storage Integration
# Required for durable persistence on serverless / Netlify deployments
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Inbound Enquiry Notifications (Optional webhook or notification)
ENQUIRY_NOTIFICATION_EMAIL=
DISCORD_LEAD_WEBHOOK_URL=
SLACK_LEAD_WEBHOOK_URL=
